{
  "name": "@levironexe/architect",
  "version": "1.0.0",
  "description": "Architecture linter for Next.js App Router projects written in TypeScript.",
  "type": "module",
  "bin": {
    "architect": "dist/cli/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "dist",
    "scripts",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-llms-txt.mjs",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:llms": "node scripts/generate-llms-txt.mjs"
  },
  "keywords": [
    "architecture",
    "linter",
    "nextjs",
    "app-router",
    "typescript",
    "code-quality",
    "cli",
    "ci",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@inquirer/prompts": "^8.7.1",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.8",
    "js-yaml": "^5.4.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
