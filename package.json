{
  "name": "@levironexe/architect",
  "version": "1.0.0",
  "description": "Architecture linter for Next.js App Router projects written in TypeScript.",
  "type": "module",
  "bin": {
    "architect": "dist/cli/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "dist",
    "scripts",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-llms-txt.mjs",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:llms": "node scripts/generate-llms-txt.mjs"
  },
  "keywords": [
    "architecture",
    "linter",
    "nextjs",
    "app-router",
    "typescript",
    "code-quality",
    "cli",
    "ci",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.1",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.7"
  }
}
